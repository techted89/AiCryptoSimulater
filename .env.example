# System
REDIS_HOST=localhost
CHROMADB_PATH=./chroma_db

# Local Inference (Actor Agent)
# Use http://host.docker.internal:11434 for Mac/Windows Docker, or the server's LAN IP (e.g. 172.17.0.1) for Linux VPS
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Fallback & Research Agents
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY_RESEARCHER=your_gemini_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
